# Database — Railway provides this automatically when you add a PostgreSQL service
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# CORS — set to your Vercel frontend URL in production
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development
